CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# add MIPS FPU
CONFIG_KERNEL_MIPS_FPU_EMULATOR=y

# wifi
CONFIG_MTK_WIFI_MODE_AP=y
CONFIG_MTK_MT_AP_SUPPORT=y
CONFIG_MTK_WDS_SUPPORT=y
CONFIG_MTK_MBSS_SUPPORT=y
CONFIG_MTK_APCLI_SUPPORT=y
CONFIG_MTK_MAC_REPEATER_SUPPORT=y
CONFIG_MTK_MUMIMO_SUPPORT=y
CONFIG_MTK_MU_RA_SUPPORT=y
CONFIG_MTK_MCAST_RATE_SPECIFIC=y
CONFIG_MTK_VOW_SUPPORT=y
CONFIG_MTK_BAND_STEERING=y
CONFIG_MTK_LED_CONTROL_SUPPORT=y
CONFIG_MTK_PCIE_ASPM_DYM_CTRL_SUPPORT=y
CONFIG_MTK_LINUX_NET_TXQ_SUPPORT=y
CONFIG_MTK_WIFI_MT_MAC=y
CONFIG_MTK_MT_MAC=y
CONFIG_MTK_CHIP_MT7615E=y
CONFIG_PACKAGE_kmod-mt7615d_dbdc=y

# MTK闭源驱动，不用则去删掉diy-part2.sh里面MTK modules


CONFIG_PACKAGE_mt7615=y
CONFIG_PACKAGE_mtk-luci-plugin=y
CONFIG_LUCI_APP_MTKWIFI=y
CONFIG_LUCI_APP_WEBCONSOLE=y

# add ipv6 support

CONFIG_PACKAGE_ipv6helper=y
# 不要指定 CONFIG_PACKAGE_dnsmasq-dhcpv=y 否则会冲突

#dropbear ssh full
# CONFIG_DROPBEAR_ECC=y
# CONFIG_DROPBEAR_ECC_FULL=y
CONFIG_DROPBEAR_ED25519=y
# CONFIG_DROPBEAR_ZLIB=y

#进程
CONFIG_PACKAGE_htop=y 

# curl
CONFIG_PACKAGE_curl=y


# 抓包
#CONFIG_PACKAGE_tcpdump=y  

CONFIG_PACKAGE_luci-app-noddos=y

# qos网速控制
# CONFIG_PACKAGE_luci-app-qosmate=y


#访问时间控制
CONFIG_PACKAGE_luci-app-accesscontrol=n 

#带宽监控
CONFIG_PACKAGE_luci-app-nlbwmon=n 


# CONFIG_PACKAGE_luci-app-commands=y
# CONFIG_PACKAGE_luci-app-diag-core=y #core诊断
# CONFIG_PACKAGE_luci-app-ttyd=y # 网页终端


# 内网穿透
CONFIG_PACKAGE_luci-app-zerotier=y

# PS4破解方案
CONFIG_PACKAGE_luci-app-pppwn=y

# CONFIG_PACKAGE_luci-ssl=y

# uhttpd已包含此功能
CONFIG_PACKAGE_luci-app-webadmin=y



# 网络加速
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_DNSFORWARDER=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_DNSPROXY=y


# 自带ddns会重启失效
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_ddns-scripts_aliyun=n
CONFIG_PACKAGE_ddns-scripts_cloudflare=n

# wol网络唤醒
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

#多拨 
# CONFIG_PACKAGE_kmod-macvlan=y
# CONFIG_PACKAGE_luci-app-mwan3=y
# CONFIG_PACKAGE_luci-app-mwan3helper=y
# CONFIG_PACKAGE_luci-app-syncdial=y

# theme
CONFIG_PACKAGE_luci-theme-argon-18.06=y
CONFIG_PACKAGE_luci-app-argon-config=y
# 去除默认 theme 节省空间
CONFIG_PACKAGE_luci-theme-bootstrap=n 
